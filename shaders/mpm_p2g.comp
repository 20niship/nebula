#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"

// MLS-MPM P2G: パーティクル並列 scatter（空間ハッシュ/近傍粒子リスト不要）
//
// 各パーティクルスレッドが自分のデータを1回だけ読み、3×3×3=27近傍グリッドノードへ
// 固定小数点atomicAddで質量・運動量(+応力由来の力項)を書き込む。
// gather方式(旧実装)は1粒子データを最大27回、隣接セルスレッドから間接参照で
// 重複読み込みしていたが、scatterでは粒子ごとに1回の連続読み込みで済む。
//
// ノード規約・重み計算はG2P(mpm_g2p.comp)と同一: base = floor(xp/h) - 1 (ドメイン下限は常に原点)
// dispatch: (particleCount + 255) / 256

#ifndef P2G_WG
#define P2G_WG 64
#endif
layout(local_size_x = P2G_WG) in;

// ── ワークグループ内の共有メモリ集約 ─────────────────────────────────────
// 近接する粒子は同じノードへ何度も atomicAdd する。ワークグループ (256 粒子) が触れるノードの AABB が
// TILE_MAX 以下なら、まず共有メモリのタイルへ集約し、最後にタイル内の非ゼロノードだけをグローバルへ 1 回ずつ加算する。
// 整数 (固定小数点) の加算なので順序に依存せず、結果は直接加算と同一。AABB が大きい (粒子の並びが空間的にばらけている)
// ときは従来どおりグローバルへ直接加算する。
#define TILE_MAX 2048u
shared uint tMass[TILE_MAX];
shared uint tMx[TILE_MAX];
shared uint tMy[TILE_MAX];
shared uint tMz[TILE_MAX];
shared int sBMin[3];
shared int sBMax[3];

void main() {
    uint p = gl_GlobalInvocationID.x;
    bool alive = p < pc.particleCount;
    // 処理順 (空間ブロック順) があればその順に処理する。粒子バッファ自体は並べ替えない (粒子番号は不変)
    if (alive && pc.sortIdx != 0u) p = readUint(pc.sortIdx, pc.sortBuckets + 2u * pc.sortCap + p);

    if (gl_LocalInvocationIndex < 3u) {
        sBMin[gl_LocalInvocationIndex] = 0x7FFFFFFF;
        sBMax[gl_LocalInvocationIndex] = -0x7FFFFFFF;
    }

    vec3  xp = vec3(0.0);
    float Vp = 0.0;
    vec3  vp = vec3(0.0);
    float mp = 0.0;
    ivec3 base = ivec3(0);
#ifndef NO_DEFORMATION
    mat3 Bp = mat3(0.0);
    float D_inv = 4.0 / (pc.cellSize * pc.cellSize);
    mat3 tau = mat3(0.0);
#endif

    if (alive) {
        vec4 pp = readVec4(pc.posIdx, p);
        xp = pp.xyz;
        Vp = pp.w;
        vec4 vp4 = readVec4(pc.velIdx, p);
        vp = vp4.xyz;

        uint  mat_pid = floatBitsToUint(vp4.w);
        float mat_rho0;
        if (pc.materialCount > 0u) {
            mat_pid  = min(mat_pid, pc.materialCount - 1u);
            mat_rho0 = uintBitsToFloat(buffers[pc.materialsIdx].data[mat_pid * 16u + 2u]);
        } else {
            mat_rho0 = pc.rho0;
        }
        mp = mat_rho0 * Vp;

        // NO_DEFORMATION (FLIP) では F・応力・APIC の粒子バッファが存在しない
#ifndef NO_DEFORMATION
        if (pc.flip_ratio < -0.5) {
            Bp = readMat3(p, pc.B0Idx, pc.B1Idx, pc.B2Idx);
        }
        tau = readStressW(p);
#endif
        base = ivec3(floor(xp / pc.cellSize)) - ivec3(1);
    }

    barrier();
    if (alive) {
        atomicMin(sBMin[0], base.x); atomicMin(sBMin[1], base.y); atomicMin(sBMin[2], base.z);
        atomicMax(sBMax[0], base.x); atomicMax(sBMax[1], base.y); atomicMax(sBMax[2], base.z);
    }
    barrier();

    // 全スレッドで同じ値になる (タイルを使うかどうかは uniform)
    const ivec3 tmn = ivec3(sBMin[0], sBMin[1], sBMin[2]);
    const ivec3 tmx = ivec3(sBMax[0], sBMax[1], sBMax[2]);
    const bool  any_alive = tmx.x >= tmn.x;
    const ivec3 text = tmx - tmn + ivec3(3);
    const uint  tvol = any_alive ? uint(text.x) * uint(text.y) * uint(text.z) : 0u;
    const bool  useTile = any_alive && tvol <= TILE_MAX;

    if (useTile) {
        for (uint i = gl_LocalInvocationIndex; i < tvol; i += uint(P2G_WG)) {
            tMass[i] = 0u; tMx[i] = 0u; tMy[i] = 0u; tMz[i] = 0u;
        }
        barrier();
    }

    if (alive) {
        for (int iz = 0; iz < 3; iz++)
        for (int iy = 0; iy < 3; iy++)
        for (int ix = 0; ix < 3; ix++) {
            ivec3 nijk = base + ivec3(ix, iy, iz);
            if (any(lessThan(nijk, ivec3(0))) ||
                any(greaterThanEqual(nijk, ivec3(pc.gridRes)))) continue;

            vec3 xi = (vec3(nijk) + 0.5) * pc.cellSize;
            vec3 d = (xp - xi) / pc.cellSize;

            float wx = bspline2(d.x), wy = bspline2(d.y), wz = bspline2(d.z);
            float w  = wx * wy * wz;
            if (w < 1e-12) continue;

            float massContrib = w * mp;
#ifndef NO_DEFORMATION
            vec3 dw = vec3(bspline2g(d.x) * wy * wz,
                           wx * bspline2g(d.y) * wz,
                           wx * wy * bspline2g(d.z)) / pc.cellSize;

            vec3 v_eff = vp + D_inv * (Bp * (xi - xp));
            vec3  momContrib  = w * mp * v_eff - pc.dt * Vp * (tau * dw);
#else
            vec3  momContrib  = w * mp * vp;
#endif

            if (useTile) {
                ivec3 l = nijk - tmn;
                uint li = uint(l.x) + uint(text.x) * (uint(l.y) + uint(text.y) * uint(l.z));
                atomicAdd(tMass[li], encodeFixed(massContrib));
                atomicAdd(tMx[li],   encodeFixed(momContrib.x));
                atomicAdd(tMy[li],   encodeFixed(momContrib.y));
                atomicAdd(tMz[li],   encodeFixed(momContrib.z));
            } else {
                uint nid = mortonEncodeI(nijk);
                atomicAdd(buffers[pc.gridMassIdx].data[nid], encodeFixed(massContrib));
                atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u],      encodeFixed(momContrib.x));
                atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 1u], encodeFixed(momContrib.y));
                atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 2u], encodeFixed(momContrib.z));
            }
        }
    }

    if (useTile) {
        barrier();
        for (uint i = gl_LocalInvocationIndex; i < tvol; i += uint(P2G_WG)) {
            uint m = tMass[i], ux = tMx[i], uy = tMy[i], uz = tMz[i];
            if ((m | ux | uy | uz) == 0u) continue; // 0 の加算は不要
            uint ex = uint(text.x);
            uint t  = i / ex;
            ivec3 nijk = tmn + ivec3(int(i % ex), int(t % uint(text.y)), int(t / uint(text.y)));
            uint nid = mortonEncodeI(nijk);
            atomicAdd(buffers[pc.gridMassIdx].data[nid], m);
            atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u],      ux);
            atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 1u], uy);
            atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 2u], uz);
        }
    }
}
