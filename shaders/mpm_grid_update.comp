#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"
#include "collider_common.glsl"
#include "force_common.glsl"
#include "force_noise.glsl"

// MPM グリッド更新: 運動量→速度変換 + 重力 + 壁 BC + 解析コライダー BC
//
// ① 軸平行壁 BC: グリッド端 2 ノード以内で法線方向速度を除去
// ② 解析コライダー BC: colliderCount > 0 のとき各プリミティブを SDF で判定
//    ColliderPrimitive 読み取りは MoltenVK 制約に従い main() でインライン展開
// dispatch: (totalCells + 255) / 256

layout(local_size_x = 256) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint totalCells = pc.hashCells;
    if (gid >= totalCells) return;

    // P2G(scatter)はgridMass/gridMomを固定小数点整数atomicAddで蓄積している。ここで最初に通常floatへデコードする
    float mass = decodeFixed(readUint(pc.gridMassIdx, gid));
    if (mass < 1e-10) return;

    vec3 mom = vec3(decodeFixed(readUint(pc.gridMomIdx, gid * 4u)),
                     decodeFixed(readUint(pc.gridMomIdx, gid * 4u + 1u)),
                     decodeFixed(readUint(pc.gridMomIdx, gid * 4u + 2u)));
    vec3 v   = mom / mass;

    // グリッド速度キャップ: 過圧縮粒子の弾性応力蓄積による速度爆発を防ぐ
    // 自由落下 10m の終端速度 ~14 m/s を上限として非物理的なピークを除去
    {
        float vspeed = length(v);
        float vmax_grid = 15.0;  // m/s
        if (vspeed > vmax_grid) v *= vmax_grid / vspeed;
    }

    // FLIP: 物理適用前の速度を後半バッファへ退避 (G2P が v_i_old として参照)
    writeVec4(pc.gridMomIdx, gid + totalCells, vec4(v, 0.0));

    // Force(空間ノイズ用の位置)より前倒しで計算 (issue #30)
    ivec3 ijk = mortonDecodeI(gid);
    vec3 forcePos = (vec3(ijk) + 0.5) * pc.cellSize + pc.worldMin;
    uint forceTypeFlag = 0u; // MPMグリッドセルにtypeFlagはないため常時全Force適用

    // FORCE_AUTOGEN_BEGIN
    // Engine::addForce/removeForce/setForces() 実行時に ForceShaderCompiler が
    // このブロックを登録済み Force 群の速度適用コード(各ForceのglslApplyVelocity()
    // から動的生成)で置換し、shaderc で全体を再コンパイルする (issue #30)。この
    // プレースホルダのままでも単体で valid な GLSL であること (既定=何もしない)。
    // 注意: mpm_grid_update.comp には predP/p の概念がないため、
    // FORCE_AUTOGEN_POST マーカー(位置制約)はここには存在しない。
    // FORCE_AUTOGEN_END

    // ② 軸平行壁 BC (B-spline support = 1.5h → 境界 2 ノード以内を不透過)
    ivec3 N = ivec3(pc.gridRes) - ivec3(1);
    if (ijk.x <= 1     && v.x < 0.0) v.x = 0.0;
    if (ijk.x >= N.x-1 && v.x > 0.0) v.x = 0.0;
    if (ijk.y <= 1     && v.y < 0.0) v.y = 0.0;
    if (ijk.y >= N.y-1 && v.y > 0.0) v.y = 0.0;
    if (ijk.z <= 1     && v.z < 0.0) v.z = 0.0;
    if (ijk.z >= N.z-1 && v.z > 0.0) v.z = 0.0;

    // ③ 解析コライダー BC
    // MoltenVK: buffers[] は main() でのみアクセス可（関数内不可）
    if (pc.colliderCount > 0u) {
        vec3 xi = forcePos; // Forceブロックで計算済みの位置を再利用

        for (uint ci = 0u; ci < pc.colliderCount; ci++) {
            uint  cbase = ci * 24u;
            uint  ctype = buffers[pc.colliderIdx].data[cbase];
            vec3  cpos  = vec3(uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 1u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 2u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 3u]));
            vec3  cnrm  = vec3(uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 4u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 5u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 6u]));
            float cr    = uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 7u]);
            vec3  cvel  = vec3(uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 8u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 9u]),
                               uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 10u]));
            float crest = uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 11u]);
            float cfric = uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 12u]);

            vec3  col_n;
            float sdf;
            float band  = 0.0; // MESH_SDF専用: 今stepで進む距離分だけ早めに判定しトンネリングを防ぐ(静止時は0=真の表面でのみ判定、box等と同じ挙動を維持)
            vec3  vColl = cvel;
            if (ctype == COLL_SPHERE) {
                sdf = sphereSDF(xi, cpos, cr, col_n);
            } else if (ctype == COLL_BOX) {
                sdf = boxSDF(xi, cpos, cnrm, col_n);
            } else if (ctype == COLL_CAPSULE) {
                sdf = capsuleSDF(xi, cpos, cnrm, cr, col_n);
            } else if (ctype == COLL_MESH_SDF) {
                uint  sdfBufIdx = buffers[pc.colliderIdx].data[cbase + 13u];
                uint  meshRes   = buffers[pc.colliderIdx].data[cbase + 14u];
                vec4  cq        = vec4(uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 16u]),
                                        uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 17u]),
                                        uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 18u]),
                                        uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 19u]));
                vec3  cw        = vec3(uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 20u]),
                                        uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 21u]),
                                        uintBitsToFloat(buffers[pc.colliderIdx].data[cbase + 22u]));
                vec3 localP = quatRotate(quatConj(cq), xi - cpos);
                vec3 nLocal;
                MESH_SDF_SAMPLE(sdfBufIdx, localP, cnrm, cr, meshRes, sdf, nLocal)
                col_n = quatRotate(cq, nLocal);
                vColl = cvel + cross(cw, xi - cpos);
                float vApproach = -dot(v - vColl, col_n); // 法線方向の接近速度(正=接近中)
                band = max(0.0, vApproach) * pc.dt * 1.5;
            } else {
                // COLL_PLANE (default)
                sdf = planeSDF(xi, cpos, cnrm, col_n);
            }

            if (sdf <= band) {
                vec3 dv = applyColliderBC(v, col_n, vColl, crest, cfric);
                // mass*(v_after-v_before) = コライダーが物体(粒子)に及ぼした力積 = 接地反力そのもの(実測: 静止重量とほぼ一致する符号・大きさで検証済み)。全サブステップ分をatomicAddで積算し、CPU側でΣ/frame_dtして平均反力[N]に変換する
                vec3 impulseOnCollider = -mass * dv;
                atomicAdd(buffers[pc.colliderForceIdx].data[ci*4u + 0u], encodeFixed(impulseOnCollider.x));
                atomicAdd(buffers[pc.colliderForceIdx].data[ci*4u + 1u], encodeFixed(impulseOnCollider.y));
                atomicAdd(buffers[pc.colliderForceIdx].data[ci*4u + 2u], encodeFixed(impulseOnCollider.z));
                vec3 torqueOnCollider = cross(xi - cpos, impulseOnCollider);
                atomicAdd(buffers[pc.colliderTorqueIdx].data[ci*4u + 0u], encodeFixed(torqueOnCollider.x));
                atomicAdd(buffers[pc.colliderTorqueIdx].data[ci*4u + 1u], encodeFixed(torqueOnCollider.y));
                atomicAdd(buffers[pc.colliderTorqueIdx].data[ci*4u + 2u], encodeFixed(torqueOnCollider.z));
            }
        }
    }

    writeVec4(pc.gridMomIdx, gid, vec4(v, 0.0));
}
