#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"

// MLS-MPM P2G: パーティクル並列 scatter（空間ハッシュ/近傍粒子リスト不要）
//
// 各パーティクルスレッドが自分のデータを1回だけ読み、3×3×3=27近傍グリッドノードへ
// 固定小数点atomicAddで質量・運動量(+応力由来の力項)を書き込む。
// gather方式(旧実装)は1粒子データを最大27回、隣接セルスレッドから間接参照で
// 重複読み込みしていたが、scatterでは粒子ごとに1回の連続読み込みで済む。
//
// ノード規約・重み計算はG2P(mpm_g2p.comp)と同一: base = floor((xp-worldMin)/h) - 1
// dispatch: (particleCount + 255) / 256

layout(local_size_x = 256) in;

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= pc.particleCount) return;

    vec4  pp = readVec4(pc.posIdx, p);
    vec3  xp = pp.xyz;
    float Vp = pp.w;
    vec4  vp4 = readVec4(pc.velIdx, p);
    vec3  vp  = vp4.xyz;

    uint  mat_pid  = floatBitsToUint(vp4.w);
    float mat_rho0;
    if (pc.materialCount > 0u) {
        mat_pid  = min(mat_pid, pc.materialCount - 1u);
        mat_rho0 = uintBitsToFloat(buffers[pc.materialsIdx].data[mat_pid * 16u + 2u]);
    } else {
        mat_rho0 = pc.rho0;
    }
    float mp = mat_rho0 * Vp;

    mat3 Bp = mat3(0.0);
    if (pc.flip_ratio < -0.5) {
        Bp = readMat3(p, pc.B0Idx, pc.B1Idx, pc.B2Idx);
    }
    float D_inv = 4.0 / (pc.cellSize * pc.cellSize);
    mat3 tau = readStressW(p);

    ivec3 base = ivec3(floor((xp - pc.worldMin) / pc.cellSize)) - ivec3(1);

    for (int iz = 0; iz < 3; iz++)
    for (int iy = 0; iy < 3; iy++)
    for (int ix = 0; ix < 3; ix++) {
        ivec3 nijk = base + ivec3(ix, iy, iz);
        if (any(lessThan(nijk, ivec3(0))) ||
            any(greaterThanEqual(nijk, ivec3(pc.gridRes)))) continue;

        vec3 xi = (vec3(nijk) + 0.5) * pc.cellSize + pc.worldMin;
        vec3 d = (xp - xi) / pc.cellSize;

        float wx = bspline2(d.x), wy = bspline2(d.y), wz = bspline2(d.z);
        float w  = wx * wy * wz;
        if (w < 1e-12) continue;

        vec3 dw = vec3(bspline2g(d.x) * wy * wz,
                       wx * bspline2g(d.y) * wz,
                       wx * wy * bspline2g(d.z)) / pc.cellSize;

        vec3 v_eff = vp + D_inv * (Bp * (xi - xp));

        float massContrib = w * mp;
        vec3  momContrib  = w * mp * v_eff - pc.dt * Vp * (tau * dw);

        uint nid = mortonEncodeI(nijk);
        atomicAdd(buffers[pc.gridMassIdx].data[nid], encodeFixed(massContrib));
        atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u],      encodeFixed(momContrib.x));
        atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 1u], encodeFixed(momContrib.y));
        atomicAdd(buffers[pc.gridMomIdx].data[nid * 4u + 2u], encodeFixed(momContrib.z));
    }
}
