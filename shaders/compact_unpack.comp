#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

// issue #87続き: compact_scatter.compが書いたスクレッチをcanonicalバッファへ書き戻す。
// 全slotが退避済みなのでin-place書き戻しで安全。フィールドの意味はcompact_scatter.compと同じ。

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.particleCount) return;
    uint idx = i + pc.fluidStart;

    vec4 p4     = readVec4(pc.lambdasIdx, i);
    vec4 v4     = readVec4Vel(pc.couplingForceIdx, i);
    uint packed = readUint(pc.cellOffsetIdx, i);

    writeVec4(pc.posIdx, idx, p4);
    writeVec4Vel(pc.velIdx, idx, v4);
    writeUint(pc.typeFlagIdx, idx, packed & 0xFFu);
    writeUint(pc.stretchEdgesIdx, idx, packed >> 8u);
}
