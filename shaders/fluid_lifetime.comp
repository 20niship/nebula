#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

layout(local_size_x = 256) in;

// 流体粒子の寿命を減算し、寿命切れを「墓場」へ送る(fluid_absorb.comp と同一パターン)。
// task2: 残り寿命はv.w(velIdx.w)に格納。invMassはP.w(posIdx.w)に格納。
void main() {
  uint i = gl_GlobalInvocationID.x;
  if(i >= pc.particleCount) return;
  uint idx = i + pc.fluidStart;

  // fluid領域の生存粒子を対象。既に墓場送り済み(type0)はスキップ
  if(readUint(pc.typeFlagIdx, idx) == 0u) return;

  vec4 v4  = readVec4Vel(pc.velIdx, idx);
  float life = v4.w; // v.wに寿命を格納 (task2)
  if(life < 0.0) return; // 負 = 無限寿命(死なない)

  life -= pc.dt;
  if(life <= 0.0) {
    // 墓場送り: typeFlag=0(死), P.w=invMass=0(不動), 位置をドメイン隅へ退避
    vec3 gr = pc.worldMin + vec3(pc.particleRadius);
    writeUint(pc.typeFlagIdx, idx, 0u);
    writeVec4(pc.posIdx, idx, vec4(gr, 0.0));    // P.w=0 = invMass=0
    writeVec4(pc.predPIdx, idx, vec4(gr, 0.0));
    writeVec4Vel(pc.velIdx, idx, vec4(0.0, 0.0, 0.0, -1.0)); // vel=0, life=-1(以後スキップ)
  } else {
    v4.w = life;
    writeVec4Vel(pc.velIdx, idx, v4); // xyzを保持したままlifeだけ更新
  }
}
