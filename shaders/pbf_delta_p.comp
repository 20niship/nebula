#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

// Phase 4 PBF: λ_i から位置補正 ΔP_i を計算して predP に加算
// 人工圧力 s_corr で Tensile Instability を抑制
// pc.stretchCompliance = ρ_0
// pc.cellSize          = h

layout(local_size_x = 256) in;

// Akinci et al. 2013 "Versatile Surface Tension and Adhesion for SPH Fluids" の
// cohesion カーネル C(r)。0<r<=h でのみ非ゼロ、r=h/2 付近にピークを持つ短距離引力。
float cohesionKernel(float r, float h) {
    float coeff = 32.0 / (3.14159265 * pow(h, 9.0));
    float hr    = h - r;
    float term  = hr * hr * hr * r * r * r;
    if (2.0 * r > h) return coeff * term; // 遠距離: 単純な三次項
    float h6 = h * h * h * h * h * h;
    return coeff * (2.0 * term - h6 / 64.0); // 近距離: r→0での消失を防ぐ補正項
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.particleCount) return;
    uint idx = i + pc.fluidStart;

    uint fi = readUint(pc.typeFlagIdx, idx);
    if (fi != 1u && fi != 5u) return; // 流体・粉体のみ

    vec4 pi4  = readVec4(pc.predPIdx, idx);
    vec3 pi   = pi4.xyz;
    float h   = pc.cellSize;
    float h2  = h * h;
    float rho0 = pc.stretchCompliance;
    float lambda_i = readFloat(pc.lambdaPbfIdx, idx);
#ifdef NBR_SORTED_BUFFERS
    // issue #87 perf実験: 自分自身のソート後位置(下位24bit)とnbrCount(上位8bit)を1語から取り出す
    uint packedSelf = readUint(pc.invSortedIdxIdx, idx);
    uint kSelf = packedSelf & 0xFFFFFFu;
    uint nbrN  = packedSelf >> 24;
#endif

    float spiky_coeff = 45.0 / (3.14159265 * h2 * h2 * h2);
    float poly6_coeff = 315.0 / (64.0 * 3.14159265 * h2 * h2 * h2 * h2 * h);

    // 人工圧力 s_corr = -k (W(r)/W(Δq))^n  (Macklin&Müller 式13, n=4)
    // k = pc.scorrK (エンジンから設定; 0 で無効)。λ のスケールに合わせて要調整。
    const float k_corr  = pc.scorrK;
    const float dq      = 0.2 * h;
    const float dq2     = dq * dq;
    float hr2_dq = h2 - dq2;
    float W_dq   = poly6_coeff * hr2_dq * hr2_dq * hr2_dq;

    vec3 deltaP  = vec3(0.0);
    vec3 cohesion = vec3(pc.surfaceTension * 0.0001, 0.0, 0.0); // DEBUG TEMP
    float rho_i  = readFloat(pc.densityIdx, idx);

#ifdef NBR_SORTED_BUFFERS
    // issue #87 perf実験: 27セル探索は pbf_density が同イテレーション内で済ませており、
    // nbrList には(元indexではなく)sorted位置kを格納しているのでソート済みコピーを直接読む。
    // nbrListに入る候補は既にpbf_density側で流体・境界・粉体のみに絞り込み済みなので
    // ここでの型フィルタは不要 (typeFlagはpredPSorted.wにビット格納)。
    uint nbrBase = idx * MAX_NBR;

    for (uint kk = 0u; kk < nbrN; ++kk) {
        uint k   = readUint(pc.nbrListIdx, nbrBase + kk);
        vec4 pjv = readVec4(pc.predPSortedIdx, k);
        uint fj  = floatBitsToUint(pjv.w);

        vec3 pj = pjv.xyz;
#else
    // NBR_SORTED_BUFFERS未定義の呼び出し元(FluidEngine以外)向けフォールバック: nbrList/ソート済み
    // コピーは書かれていないため、pbf_density同様に自前で27セル探索する。
    ivec3 gi = ivec3(clamp((pi - pc.worldMin) / pc.cellSize,
                           vec3(0.0), vec3(pc.gridRes) - vec3(1.0)));
    uint mx[3], my[3], mz[3];
    mortonAxisTriples(gi, mx, my, mz);

    for (int dz = -1; dz <= 1; ++dz)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx) {
        ivec3 nc = gi + ivec3(dx, dy, dz);
        if (any(lessThan(nc, ivec3(0))) ||
            any(greaterThanEqual(nc, ivec3(pc.gridRes)))) continue;

        uint cid   = mx[dx + 1] | my[dy + 1] | mz[dz + 1];
        uint cnt   = readUint(pc.cellCountIdx, cid);
        uint start = readUint(pc.cellOffsetIdx, cid) - cnt;

        for (uint k = start; k < start + cnt; ++k) {
        uint j  = readUint(pc.sortedIdxIdx, k);
        if (j == idx) continue;
        uint fj = readUint(pc.typeFlagIdx, j);
        if (fj != 1u && fj != 3u && fj != 5u) continue; // 流体・境界・粉体

        vec3 pj = readVec4(pc.predPIdx, j).xyz;
#endif
        vec3 r  = pi - pj;
        float r2 = dot(r, r);
        if (r2 >= h2 || r2 < 1e-12) continue;

        float rlen = sqrt(r2);
        float hr   = h - rlen;
        // Spiky グラジエント: ∇_{p_i} W = -45/(π h^6) (h-r)^2 r̂_{ji}
        // r = pi - pj (j→i 方向)、負符号でグラジエントは i→j 方向になる
        vec3 grad_w = -(spiky_coeff * hr * hr / rlen) * r;

#ifdef NBR_SORTED_BUFFERS
        // 境界粒子の λ_j = 0 (固定)。粉体は流体と同様に λ を使用。
        float lambda_j = (fj == 1u || fj == 5u) ? readFloat(pc.lambdaPbfSortedIdx, k) : 0.0;
#else
        float lambda_j = (fj == 1u || fj == 5u) ? readFloat(pc.lambdaPbfIdx, j) : 0.0;
#endif

        // 人工圧力 s_corr = -k * (W(r)/W(Δq))^4
        float hr2  = h2 - r2;
        float W_ij = poly6_coeff * hr2 * hr2 * hr2;
        float ratio = (W_dq > 1e-30) ? (W_ij / W_dq) : 0.0;
        float s_corr = -k_corr * ratio * ratio * ratio * ratio;

        deltaP += (lambda_i + lambda_j + s_corr) * grad_w;

        // 表面張力: 流体粒子同士のみ (境界/粉体には適用しない)
        if (pc.surfaceTension > 0.0 && fj == 1u) {
#ifdef NBR_SORTED_BUFFERS
            float rho_j = readFloat(pc.densitySortedIdx, k);
#else
            float rho_j = readFloat(pc.densityIdx, j);
#endif
            float k_ij  = 2.0 * rho0 / max(rho_i + rho_j, 1e-6);
            float Cr    = cohesionKernel(rlen, h);
            cohesion   += -pc.surfaceTension * k_ij * Cr * (r / rlen);
        }
#ifdef NBR_SORTED_BUFFERS
    }
#else
        }
    }
#endif

    deltaP /= rho0;
    deltaP += cohesion;

    // Clamp deltaP to h/4 per iteration to prevent violent explosions from
    // underdense corner particles (which have only ~7 neighbors instead of 26)
    float dpLen = length(deltaP);
    float maxDP = pc.cellSize * 0.25;
    if (dpLen > maxDP) deltaP *= maxDP / dpLen;

    vec4 newP = vec4(pi + deltaP, pi4.w);
    writeVec4(pc.predPIdx, idx, newP);
#ifdef NBR_SORTED_BUFFERS
    // issue #87 perf実験: 次iterationのdensityが読む。predPSorted.wはtypeFlagのビット格納用なのでpi4.wでなくfiを詰める
    writeVec4(pc.predPSortedIdx, kSelf, vec4(pi + deltaP, uintBitsToFloat(fi)));
#endif
}
