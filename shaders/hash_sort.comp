#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

// Pass 3: cellOffset を消費しながら sortedIdx を埋める
// cellOffset はこの pass で破壊されるが、次フレームで再計算されるので問題なし

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.particleCount) return;

    // issue #70: hash_count.comp と同じ論理→実添字変換 (詳細はそちらのコメント参照)。
    uint idx = (i < pc.boundaryUsedCount) ? i : (pc.fluidStart + (i - pc.boundaryUsedCount));

    // hash_count.comp と対称に未使用スロット（typeFlag=6=TYPE_FLAG_UNUSED）を除外する
    // （cellCount と数を揃える必要がある）。
    if (readUint(pc.typeFlagIdx, idx) == 6u) return;

    vec4 predP = readVec4(pc.predPIdx, idx);
    uint cid   = cellId(predP.xyz);

    uint slot = atomicAdd(buffers[pc.cellOffsetIdx].data[cid], 1u);
    // sortedIdx には実バッファ添字(idx)を格納する。後続パス(pbf_density等)は
    // これを直接 predP/typeFlag 等の添字として使うため、論理添字(i)ではなく実添字が必要。
    buffers[pc.sortedIdxIdx].data[slot] = idx;
}
