#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"

// Pass 3: cellOffset を消費しながら sortedIdx を埋める
// cellOffset はこの pass で破壊されるが、次フレームで再計算されるので問題なし

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.particleCount) return;

    // hash_count.comp と対称に未使用スロット（typeFlag=6=TYPE_FLAG_UNUSED）を除外する
    // （cellCount と数を揃える必要がある）。
    uint fi = readUint(pc.typeFlagIdx, i);
    if (fi == 6u) return;

    vec4 predP = readVec4(pc.predPIdx, i);
    uint cid   = cellId(predP.xyz);

    uint slot = atomicAdd(buffers[pc.cellOffsetIdx].data[cid], 1u);
    buffers[pc.sortedIdxIdx].data[slot] = i;

    // issue #87 perf実験: 逆写像とソート済みコピーを同じpassで書く (density/delta_pの近傍gather
    // がsortedIdx経由の間接参照なしにkで直接コアレス読みできるようにする)。typeFlagは
    // predPSorted.wにビット格納し専用バッファを節約 (predP.wはこの用途では未使用のため)。
    writeUint(pc.invSortedIdxIdx, i, slot);
    writeVec4(pc.predPSortedIdx, slot, vec4(predP.xyz, uintBitsToFloat(fi)));
}
