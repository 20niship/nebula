#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"

// 粒子が P2G/G2P で触れる格子ノードの AABB を求める (アクティブ領域)。
// ワークグループ内で共有メモリの atomic で縮約し、グループごとに 1 回だけグローバルへ atomicMin/Max する。
// activeBox バッファ: [0..2]=最小ノード (初期値 0xFFFFFFFF), [3..5]=最大ノード (初期値 0)。mpm_bounds_finish.comp が消費して初期値に戻す。
// 触れるノードは P2G/G2P と同じ base = floor(xp/h) - 1 から +2 までの 3 ノード (領域外はクランプ)。
// dispatch: (particleCount + 255) / 256

layout(local_size_x = 256) in;

shared uint sMin[3];
shared uint sMax[3];

void main() {
    if (gl_LocalInvocationIndex < 3u) {
        sMin[gl_LocalInvocationIndex] = 0xFFFFFFFFu;
        sMax[gl_LocalInvocationIndex] = 0u;
    }
    barrier();

    uint p = gl_GlobalInvocationID.x;
    if (p < pc.particleCount) {
        vec3 xp    = readVec4(pc.posIdx, p).xyz;
        ivec3 base = ivec3(floor(xp / pc.cellSize)) - ivec3(1);
        ivec3 top  = ivec3(pc.gridRes) - ivec3(1);
        uvec3 lo   = uvec3(clamp(base, ivec3(0), top));
        uvec3 hi   = uvec3(clamp(base + ivec3(2), ivec3(0), top));
        atomicMin(sMin[0], lo.x); atomicMin(sMin[1], lo.y); atomicMin(sMin[2], lo.z);
        atomicMax(sMax[0], hi.x); atomicMax(sMax[1], hi.y); atomicMax(sMax[2], hi.z);
    }
    barrier();

    if (gl_LocalInvocationIndex == 0u && sMin[0] != 0xFFFFFFFFu) {
        atomicMin(buffers[pc.boxIdx].data[0], sMin[0]);
        atomicMin(buffers[pc.boxIdx].data[1], sMin[1]);
        atomicMin(buffers[pc.boxIdx].data[2], sMin[2]);
        atomicMax(buffers[pc.boxIdx].data[3], sMax[0]);
        atomicMax(buffers[pc.boxIdx].data[4], sMax[1]);
        atomicMax(buffers[pc.boxIdx].data[5], sMax[2]);
    }
}
