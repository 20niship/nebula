#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"

// P2G 前に固定小数点atomicAdd蓄積バッファ(gridMom/gridMass)をゼロクリア
// gridVel/gridVelOldはG2P側でgridMass(ここでクリアした値)が閾値未満のセルを読まないためクリア不要

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint totalCells = pc.hashCells;
    if (i >= totalCells) return;
    writeVec4(pc.gridMomIdx, i, vec4(0.0));
    writeFloat(pc.gridMassIdx, i, 0.0);
}
