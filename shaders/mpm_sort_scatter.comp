#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#include "mpm_common.glsl"

// 粒子の処理順の作成 ③ 処理順 (粒子番号) を書き出す: order[開始位置[ブロック] + 順位] = 粒子番号。dispatch: (particleCount + 255) / 256

layout(local_size_x = 256) in;

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= pc.particleCount) return;
    uint b    = buffers[pc.sortIdx].data[pc.sortBuckets + p];
    uint rank = buffers[pc.sortIdx].data[pc.sortBuckets + pc.sortCap + p];
    uint off  = buffers[pc.sortIdx].data[b];
    buffers[pc.sortIdx].data[pc.sortBuckets + 2u * pc.sortCap + off + rank] = p;
}
